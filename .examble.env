PORT=8080
PROVIDER_BASE_URL=https://ramclouds.me/v1  # Anthropic endpoint
PROVIDER_API_KEY=sk-.... # key cho opus
OPENAI_BASE_URL=https://ramclouds.me/v1  # hoặc endpoint khác
OPENAI_API_KEY=sk-.... # key riêng cho OpenAI
THINKING_BUDGET=4096

# context controls
RAM_SOFT_LIMIT_TOKENS=185000
RAM_HARD_LIMIT_TOKENS=188000
KEEP_LAST_MESSAGES=12
SUMMARY_MAX_TOKENS=900
SANITIZE_SYSTEM=1
TRIM_TOOLS=1

# --- Provider detection ---
# Comma-separated prefixes to identify Anthropic models (default: claude-)
ANTHROPIC_PREFIXES=claude-

# --- Default model (used when no model specified in request) ---
DEFAULT_MODEL=claude-opus-4-5

# --- Model mapping ---
# All model alias → actual model mappings go here as JSON.
# Key = alias name (from Cursor), Value = actual model to send to provider.
EXTRA_MODEL_MAP={"gpt-5.1-codex-mini":"gpt-5.1-codex-mini","gpt-5.2":"gpt-5.2","gpt-5.3-codex-spark-preview":"gpt-5.3-codex-spark", "claude-opus-4.6-thinking":"claude-opus-4.6-CL","gpt-5.3-codex":"gpt-5.3-codex","gpt-5.4":"gpt-5.4"}

# Legacy model map (merged with EXTRA_MODEL_MAP)
MODEL_MAP_JSON={"claude-opus-4.6-thinking":"claude-opus-4.6-CL","claude-4.6-opus-high-thinking":"claude-opus-4.6-CL","claude-4.6-opus-thinking":"claude-opus-4.6-CL","claude-4.6-opus":"claude-opus-4.6-CL"}