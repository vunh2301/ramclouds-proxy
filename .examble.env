PORT=8080
PROVIDER_BASE_URL=https://ramclouds.me/v1  # Anthropic endpoint
PROVIDER_API_KEY=sk-.... # key cho opus
OPENAI_BASE_URL=https://ramclouds.me/v1  # hoặc endpoint khác
OPENAI_API_KEY=sk-.... # key riêng cho OpenAI
THINKING_BUDGET=4096

# context controls
RAM_SOFT_LIMIT_TOKENS=185000
RAM_HARD_LIMIT_TOKENS=188000
KEEP_LAST_MESSAGES=12
SUMMARY_MAX_TOKENS=900
SANITIZE_SYSTEM=1
TRIM_TOOLS=1

# --- Tool Result Batching ---
# Gom nhieu tool results lai thanh 1 request de tiet kiem luot goi API
# Khi Claude tra ve nhieu tool_use cung luc, client co the gui tung result rieng le
# Bat tinh nang nay se doi them BATCH_WINDOW_MS truoc khi forward, gop cac result lai
BATCH_TOOL_RESULTS=0
BATCH_WINDOW_MS=350

# --- Merge Tool Calls ---
# Ep AI gop nhieu lenh shell thanh 1 tool call duy nhat (vd: 3 lan sh -> 1 lan sh voi &&)
# Inject prompt vao system de AI tu gom cac lenh doc-only lai voi nhau
MERGE_TOOL_CALLS=0
# Danh sach ten tool duoc coi la "shell" (phan cach bang dau phay)
MERGE_TOOL_NAMES=sh,bash,shell,terminal,run_command,execute_command,run_terminal_command

# --- Provider detection ---
# Comma-separated prefixes to identify Anthropic models (default: claude-)
ANTHROPIC_PREFIXES=claude-

# --- AMP CLI adapter ---
# Bat/tat AMP adapter
AMP_ENABLED=1
# Prefix model de fallback detect AMP neu khong co header/metadata
AMP_PREFIXES=amp-
# Mode mac dinh neu client khong gui mode hoac gui mode sai
AMP_DEFAULT_MODE=smart
# Danh sach mode hop le
AMP_ALLOWED_MODES=smart,deep,fast,plan
# Doc mode tu dau: metadata | body | both
AMP_MODE_SOURCE=both
# Ten field mode (metadata[field] hoac body[field])
AMP_MODE_FIELD=mode
# Gan tag mode vao metadata forward de trace log
AMP_ATTACH_MODE_TAG=1
# Custom mode presets (merge vao defaults). Vi du:
# AMP_MODE_MAP_JSON={"turbo":{"reasoning":{"effort":"low"},"parallel_tool_calls":true}}
AMP_MODE_MAP_JSON=

# Amp Access Token -> ampcode.com -> Settings -> Access Token
# Legacy token (fallback cho inbound/upstream key neu khong set rieng)
AMP_ACCESS_TOKEN=
# Upstream AMP base URL (co the da bao gom /api)
AMP_BASE_URL=https://amp.example.com
# Key duoc client AMP CLI gui vao proxy (comma-separated)
AMP_INBOUND_API_KEYS=local-amp-key-1,local-amp-key-2
# Chi cho phep goi /api/* tu localhost
AMP_REQUIRE_LOCALHOST=0
# Key proxy inject server-side khi forward len AMP upstream
AMP_UPSTREAM_API_KEY=sk-amp-upstream
# Timeout cho AMP upstream request (ms)
AMP_TIMEOUT_MS=60000

# --- AMP CLI login orchestrator (/api/amp-cli/*) ---
# Bat/tat AMP CLI login orchestration local
AMP_CLI_ENABLED=0
# Lenh CLI co dinh de chay login (khong doc tu request body)
AMP_CLI_COMMAND=amp
# Hard timeout cho amp login (ms)
AMP_CLI_LOGIN_TIMEOUT_MS=480000
# TTL session login (ms)
AMP_CLI_SESSION_TTL_MS=600000
# Giu lai status terminal de client poll them (ms)
AMP_CLI_STATUS_RETENTION_MS=120000
# So login amp cho phep chay dong thoi
AMP_CLI_MAX_CONCURRENT=1

# --- Default model (used when no model specified in request) ---
DEFAULT_MODEL=claude-opus-4-5

# --- Model mapping (Cursor / global) ---
# All model alias → actual model mappings go here as JSON.
# Key = alias name (from Cursor), Value = actual model to send to provider.
EXTRA_MODEL_MAP={"gpt-5.1-codex-mini":"gpt-5.1-codex-mini","gpt-5.2":"gpt-5.2","gpt-5.3-codex-spark-preview":"gpt-5.3-codex-spark", "claude-opus-4.6-thinking":"claude-opus-4.6-CL","gpt-5.3-codex":"gpt-5.3-codex","gpt-5.4":"gpt-5.4"}

# Legacy model map (merged with EXTRA_MODEL_MAP)
MODEL_MAP_JSON={"claude-opus-4.6-thinking":"claude-opus-4.6-CL","claude-4.6-opus-high-thinking":"claude-opus-4.6-CL","claude-4.6-opus-thinking":"claude-opus-4.6-CL","claude-4.6-opus":"claude-opus-4.6-CL"}

# --- AMP CLI model mapping (riêng cho AMP CLI) ---
# Nếu set, AMP CLI dùng map này thay vì MODEL_MAP global.
# Nếu không set, fallback về MODEL_MAP global.
# AMP CLI modes gửi các model sau:
#   smart → gemini-3-pro-preview, gemini-2.5-flash (Google)
#   rush  → claude-haiku-4-5-20251001 (Anthropic)
#   deep  → gpt-5.3-codex (OpenAI), claude-opus-4-6 (Anthropic)
#   free  → gemini models (Google)
#   oracle subagent → gpt-5 (OpenAI)
#   librarian       → claude-sonnet-4-5-20250929 (Anthropic)
AMP_MODEL_MAP_JSON={"claude-opus-4-6":"gpt-5.4","claude-haiku-4-5-20251001":"gpt-5.4","claude-sonnet-4-5-20250929":"gpt-5.4","gemini-3-pro-preview":"gpt-5.4","gemini-3-pro":"gpt-5.4","gemini-2.5-flash":"gpt-5.4","gpt-5.3-codex":"gpt-5.4","gpt-5":"gpt-5.4"}
# Default model cho AMP CLI khi request không có model
AMP_DEFAULT_MODEL=gpt-5.4