PORT=8080
PROVIDER_BASE_URL=https://ramclouds.me/v1  # Endpoint Anthropic
PROVIDER_API_KEY=sk-.... # Key cho upstream
OPENAI_BASE_URL=https://api.openai.com/v1  # Hoặc endpoint khác
OPENAI_API_KEY=sk-.... # Key riêng cho OpenAI
# Provider mode: ramclouds | openai | auto
# ramclouds: tất cả qua ramclouds (mặc định)
# openai: Responses API gửi thẳng OpenAI (web search native, không intercept)
# auto: tự detect — GPT models → OpenAI, còn lại → ramclouds
PROVIDER_MODE=ramclouds
THINKING_BUDGET=4096

# --- Quản lý context ---
RAM_SOFT_LIMIT_TOKENS=185000
RAM_HARD_LIMIT_TOKENS=188000
KEEP_LAST_MESSAGES=12
SUMMARY_MAX_TOKENS=900
SANITIZE_SYSTEM=1
TRIM_TOOLS=1

# --- Gom tool results ---
# Gom nhiều tool results thành 1 request để tiết kiệm lượt gọi API
BATCH_TOOL_RESULTS=0
BATCH_WINDOW_MS=350

# --- Gộp lệnh shell ---
# Ép AI gộp nhiều lệnh shell thành 1 tool call duy nhất
MERGE_TOOL_CALLS=0
MERGE_TOOL_NAMES=sh,bash,shell,terminal,run_command,execute_command,run_terminal_command

# --- Nhận diện provider ---
ANTHROPIC_PREFIXES=claude-

# --- Model mặc định ---
DEFAULT_MODEL=claude-opus-4-5

# --- Ánh xạ model (Cursor / global) ---
# Key = tên alias (từ Cursor), Value = model thật gửi cho provider
EXTRA_MODEL_MAP={"claude-opus-4.6-thinking":"claude-opus-4.6-CL","gpt-5.3-codex":"gpt-5.3-codex","gpt-5.4":"gpt-5.4"}

# Legacy model map (merge với EXTRA_MODEL_MAP)
MODEL_MAP_JSON={"claude-opus-4.6-thinking":"claude-opus-4.6-CL","claude-4.6-opus":"claude-opus-4.6-CL"}

# ==============================================================
# AMP CLI
# ==============================================================

# --- Bật/tắt AMP ---
AMP_ENABLED=1
AMP_PREFIXES=amp-

# --- AMP mode ---
AMP_DEFAULT_MODE=smart
AMP_ALLOWED_MODES=smart,deep,fast,plan
AMP_MODE_SOURCE=both
AMP_MODE_FIELD=mode
AMP_ATTACH_MODE_TAG=1
# Custom mode presets (merge vào defaults):
# AMP_MODE_MAP_JSON={"turbo":{"reasoning":{"effort":"low"},"parallel_tool_calls":true}}
AMP_MODE_MAP_JSON=

# --- AMP Management Proxy ---
AMP_PROXY_ENABLED=1
AMP_BASE_URL=https://ampcode.com
# Key client AMP CLI gửi vào proxy (phân tách dấu phẩy)
AMP_INBOUND_API_KEYS=local-amp-key-1,local-amp-key-2
# Chỉ cho phép gọi /api/* từ localhost
AMP_REQUIRE_LOCALHOST=0
# Key inject server-side khi forward lên AMP upstream
AMP_UPSTREAM_API_KEY=sk-amp-upstream
# Timeout cho upstream request (ms)
AMP_TIMEOUT_MS=60000

# --- AMP Access Token ---
# Lấy từ ampcode.com -> Settings -> Access Token
# Fallback cho inbound/upstream key nếu không set riêng
AMP_ACCESS_TOKEN=

# --- AMP CLI Login Orchestrator ---
AMP_CLI_ENABLED=1
AMP_CLI_COMMAND=amp
AMP_CLI_LOGIN_TIMEOUT_MS=480000
AMP_CLI_SESSION_TTL_MS=600000
AMP_CLI_STATUS_RETENTION_MS=120000
AMP_CLI_MAX_CONCURRENT=1

# --- AMP Model Mapping ---
# Cấu hình trong file amp-models.jsonc (ưu tiên) hoặc biến dưới đây
# File amp-models.jsonc hỗ trợ:
#   - Comment (// và /* */)
#   - Format: "role/model": ["primary", "fallback1", "fallback2"]
#   - Fallback chain tự động khi model bị 429/500/502/503/504
#   - Xem amp-models.jsonc để biết chi tiết

# Fallback nếu không có file amp-models.jsonc:
# AMP_MODEL_MAP_JSON={"claude-opus-4-6":"claude-opus-4.6-CL","gpt-5.3-codex":"claude-opus-4.6-CL"}

# Model mặc định cho AMP CLI khi request không có model
AMP_DEFAULT_MODEL=claude-opus-4.6-CL

# --- Smart Fallback ---
# Thời gian đánh dấu model DOWN (ms) - sau thời gian này sẽ thử lại
AMP_MODEL_DOWN_TTL_MS=120000
# Khoảng cách giữa các lần probe kiểm tra model hồi phục (ms)
AMP_MODEL_PROBE_INTERVAL_MS=30000
# --- Web Search ---
# Backend ưu tiên: Brave > Tavily > Serper > Google News RSS > DDG > Bing
# 1. Brave Search API (cần thẻ): https://brave.com/search/api/
BRAVE_API_KEY=
# 2. Tavily AI Search (free 1000/tháng, không cần thẻ): https://tavily.com
TAVILY_API_KEY=
# 3. Exa AI Search (free 1000/tháng, không cần thẻ): https://exa.ai
EXA_API_KEY=
# 4. Serper.dev (free 2500 queries, chỉ cần Google account): https://serper.dev
SERPER_API_KEY=
# 4. SearXNG (free, tự host hoặc public instance)
WEB_SEARCH_URL=
# Số kết quả search (1-20, default 5)
WEB_SEARCH_COUNT=10
# Giới hạn lượt/tháng (tự động skip khi hết, chuyển backend tiếp theo)
BRAVE_MONTHLY_LIMIT=1000
TAVILY_MONTHLY_LIMIT=1000
EXA_MONTHLY_LIMIT=1000
SERPER_MONTHLY_LIMIT=2500